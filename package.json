{
  "name": "coolapk-desktop-local",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "基于酷安 APK 协议分析的非官方 Windows 桌面客户端",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "probe": "node scripts/probe.mjs",
    "package": "pnpm prepare:phone && pnpm build && electron-builder --win portable --publish never",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:features": "node scripts/test-features.mjs",
    "test:resource-retry": "node scripts/test-resource-retry.mjs",
    "test:hot-topics": "node scripts/test-hot-topics.mjs",
    "test:media": "node scripts/test-media.mjs",
    "prepare:phone": "node scripts/prepare-phone.mjs",
    "test:catalog": "node scripts/test-catalog.mjs",
    "test:community": "node scripts/test-community.mjs",
    "test:article": "node scripts/test-article.mjs",
    "test:publishing": "node scripts/test-publishing.mjs",
    "test:account": "node scripts/test-account-ui.mjs",
    "test:phone": "node scripts/test-phone.mjs --live",
    "test:navigation": "node scripts/test-navigation.mjs",
    "test:live-photo": "node scripts/test-live-photo.mjs",
    "test:goods": "node scripts/test-goods.mjs",
    "test:downloads": "node scripts/test-downloads.mjs",
    "test:sharing": "node scripts/test-sharing.mjs",
    "test:search": "node scripts/test-search-ui.mjs",
    "test:secondhand": "node scripts/test-secondhand.mjs",
    "test:app-discovery": "node scripts/test-app-discovery.mjs",
    "test:user-discovery": "node scripts/test-user-discovery.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "playwright": "1.62.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "local.coolapk.desktop",
    "productName": "酷安桌面端",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Coolapk-Desktop-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "extraResources": [
      {
        "from": ".local/tools/scrcpy",
        "to": "scrcpy",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
